# ── Eliva - AI Call Attendant ──
# Copy this file to .env and fill in your credentials

# Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your-api-key-here

# Twilio credentials (get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Your personal phone number (for forwarding when not busy)
MY_PHONE_NUMBER=+1234567890

# Your name (Eliva will introduce itself on behalf of you)
MY_NAME=DJ

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
PORT=5000
